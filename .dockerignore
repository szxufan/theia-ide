# The build context needs the theia framework submodule: the root postinstall
# compiles it and links its packages into node_modules, so that the image
# contains the framework modifications (e.g. built-in Chinese localization)
# instead of the npm-published @theia/* packages.

# Keep build-irrelevant files out of the context
.git
.nx
**/node_modules
**/lib

# The committed plugins/ directory ships inside the image (offline plugin
# seeding for download:plugins). Its lib/node_modules subdirectories are part
# of the plugins themselves and must not be stripped by the rules above
# (e.g. vscjava.vscode-gradle/extension/lib jars).
!plugins/**

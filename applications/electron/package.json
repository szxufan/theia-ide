  "scripts": {
    "clean": "theia clean && rimraf node_modules",
    "clean:dist": "rimraf dist .stage",
    "build": "pnpm rebuild && theia build --app-target=\"electron\" --mode development",
    "build:prod": "pnpm rebuild && theia build --app-target=\"electron\"",
    "rebuild": "theia rebuild:electron --cacheRoot ../.. && node ../../node_modules/electron/install.js",
    "watch": "concurrently -n compile,build \"theiaext watch --preserveWatchOutput\" \"theia build --watch --mode development\"",
    "start": "electron scripts/theia-electron-main.js --plugins=local-dir:../../plugins",
    "start:debug": "pnpm start --log-level=debug",
    "package:prod": "pnpm deploy",
    "update:checksum": "ts-node scripts/update-checksum.ts",
    "update:blockmap": "ts-node scripts/update-blockmap.ts",
    "update:theia": "ts-node ../../scripts/update-theia-version.ts",
    "update:next": "ts-node ../../scripts/update-theia-version.ts next",
    "sign:directory": "ts-node scripts/sign-directory.ts",
    "sign:directory:windows": "ts-node scripts/sign-directory-windows.ts",
    "test": "mocha --timeout 60000 \"./test/*.spec.js\"",
    "lint": "eslint --ext js,jsx,ts,tsx scripts && eslint --ext js,jsx,ts,tsx test",
    "lint:fix": "eslint --ext js,jsx,ts,tsx scripts --fix && eslint --ext js,jsx,ts,tsx test -fix",
    "package:run": "pnpm clean:dist && pnpm run rebuild && node scripts/stage-app.cjs --publish never",
    "deploy:run": "pnpm clean:dist && pnpm run rebuild && node scripts/stage-app.cjs --publish always",
    "package:preview:run": "pnpm clean:dist && pnpm run rebuild && node scripts/stage-app.cjs --dir",
    "package": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm run package:run",
    "deploy": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm run deploy:run",
    "package:preview": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm run package:preview:run"
  }
}

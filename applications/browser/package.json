    "@theia/ai-ollama": "workspace:*",
    "@theia/ai-openai": "workspace:*",
    "@theia/ai-registry": "workspace:*",
    "@theia/ai-scanoss": "workspace:*",
    "@theia/ai-terminal": "workspace:*",
    "@theia/bulk-edit": "workspace:*",
